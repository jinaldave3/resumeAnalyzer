{
  "manifest_version": 3,
  "name": "Resume Analyzer",
  "version": "2.0",
  "description": "Analyze your resume against job descriptions directly on LinkedIn, Indeed, and other job boards.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  }
}
