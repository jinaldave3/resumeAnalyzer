{
  "manifest_version": 3,
  "name": "Resume Analyzer",
  "version": "1.0",
  "description": "Analyze your resume against job descriptions directly on LinkedIn, Indeed, and other job boards.",
  "permissions": ["scripting", "activeTab", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  }
}
